<?xml version="1.0" encoding="utf-8" ?>
<configuration>
  <connectionStrings>
    <add name="KioscoDB"
         connectionString="Server=localhost;Port=3306;Database=kiosco_db;Uid=root;Pwd=1234;CharSet=utf8mb4;Pooling=true;MinimumPoolSize=0;MaximumPoolSize=25;ConnectionTimeout=5;DefaultCommandTimeout=15;SslMode=Preferred;AllowUserVariables=true;"
         providerName="MySql.Data.MySqlClient" />
  </connectionStrings>
  <appSettings>
    <add key="DirectorioBackups" value="Backups" />
    <add key="RutaMySqlDump" value="" />
  </appSettings>
</configuration>
